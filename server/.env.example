# Server Configurations
PORT=5000
NODE_ENV=development

# Database Configurations
MONGODB_URI=mongodb://localhost:27017/espacio

# Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_here_espacio_2026
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_here_espacio_2026

# Email Settings (Nodemailer Configuration)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=espacio.hyd@gmail.com
SMTP_PASS=your_app_password_here
EMAIL_FROM=Espacio Interiors <espacio.hyd@gmail.com>

# Storage Selection: local / cloudinary / s3 / supabase
STORAGE_PROVIDER=local

# Cloudinary Credentials (Optional - if STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Maps Credentials (Optional)
GOOGLE_MAPS_API_KEY=

# Google Sheets Lead Synchronization
# Option A: Google Apps Script Webhook (Easiest - 2 min setup)
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/.../exec

# Option B: Official Google Sheets API v4 (Service Account)
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=All Leads
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

